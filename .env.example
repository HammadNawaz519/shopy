# ==============================================================================
# SHOPY ECOSYSTEM CONFIGURATION TEMPLATE
# ==============================================================================

# Application Base
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Security & Sessions (JWT / Iron Session Secret)
SESSION_SECRET="replace_with_a_64_character_cryptographically_secure_random_string"

# Supabase PostgreSQL (Single Source of Truth)
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require"

# Upstash Redis (Performance Optimization & Rate Limiting Coordination)
UPSTASH_REDIS_REST_URL="https://your-database.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# Google Sheets Synchronization (Non-Blocking Business Mirror)
GOOGLE_SHEETS_SPREADSHEET_ID="your_google_sheets_spreadsheet_id"
GOOGLE_SERVICE_ACCOUNT_EMAIL="your_service_account@project.iam.gserviceaccount.com"
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# SMTP 3-Inbox Dispatch System
# 1. OTP / Auth
SMTP_OTP_HOST="smtp.gmail.com"
SMTP_OTP_PORT=465
SMTP_OTP_USER="shopy.otp@gmail.com"
SMTP_OTP_PASS="your_app_password"

# 2. Order Lifecycle & Status
SMTP_ORDER_HOST="smtp.gmail.com"
SMTP_ORDER_PORT=465
SMTP_ORDER_USER="shopy.orderupdate@gmail.com"
SMTP_ORDER_PASS="your_app_password"

# 3. Support & Concierge
SMTP_SUPPORT_HOST="smtp.gmail.com"
SMTP_SUPPORT_PORT=465
SMTP_SUPPORT_USER="shopy.support@gmail.com"
SMTP_SUPPORT_PASS="your_app_password"
