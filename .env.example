# ============================================================================
# SHOPY NEXT.JS PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================

# 1. JWT & Session Security (Min 32 characters)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long

# 2. Application Meta & Branding
NEXT_PUBLIC_APP_NAME=SHOPY
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_CURRENCY=PKR
NEXT_PUBLIC_CURRENCY_SYMBOL=Rs.
ADMIN_EMAIL=your_admin_email@domain.com
NODE_ENV=production

# 3. PostgreSQL Database
DATABASE_URL="postgresql://user:password@host:6543/postgres"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# ============================================================================
# SHOPY 3-TIER MULTI-ACCOUNT SMTP CONFIGURATION (SERVER-ONLY - ZERO EXPOSURE)
# ============================================================================

# SENDER 1: OTP & Authentication Account (shopy.otp@gmail.com)
# Purpose: Signup OTP, Login Verification, Password Recovery, Security Alerts
SMTP_OTP_HOST=smtp.gmail.com
SMTP_OTP_PORT=465
SMTP_OTP_SECURE=true
SMTP_OTP_USER=shopy.otp@gmail.com
SMTP_OTP_PASSWORD=your_otp_app_password
SMTP_OTP_FROM_NAME="SHOPY Security"

# SENDER 2: Order Lifecycle Account (shopy.orderupdate@gmail.com)
# Purpose: Order Confirmations, Shipping Updates, Delivery & Refund Notifications
SMTP_ORDER_HOST=smtp.gmail.com
SMTP_ORDER_PORT=465
SMTP_ORDER_SECURE=true
SMTP_ORDER_USER=shopy.orderupdate@gmail.com
SMTP_ORDER_PASSWORD=your_order_app_password
SMTP_ORDER_FROM_NAME="SHOPY Orders"

# SENDER 3: Support & Concierge Account (shopy.support@gmail.com)
# Purpose: Contact Form Dispatches, Concierge Inquiries, Customer Service
SMTP_SUPPORT_HOST=smtp.gmail.com
SMTP_SUPPORT_PORT=465
SMTP_SUPPORT_SECURE=true
SMTP_SUPPORT_USER=shopy.support@gmail.com
SMTP_SUPPORT_PASSWORD=your_support_app_password
SMTP_SUPPORT_FROM_NAME="SHOPY Concierge"

# ============================================================================
# GOOGLE OAUTH 2.0 CONFIGURATION (SERVER-ONLY - ZERO LEAK GUARANTEE)
# ============================================================================
# Authorized Redirect URI in Google Cloud Console:
# Production: https://buyatshopy.vercel.app/api/auth/callback/google
# Development: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================================================
# 5. GROQ AI ENGINE (Sartorial Motivation & Editorial Quotes)
# ============================================================================
GROQ_API_KEY=your_groq_api_key

